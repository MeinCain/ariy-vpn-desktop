{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ariy VPN",
  "version": "0.2.0-beta.36",
  "identifier": "com.ariyvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ariy VPN",
        "width": 420,
        "height": 780,
        "minWidth": 420,
        "minHeight": 780,
        "maxWidth": 420,
        "maxHeight": 780,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ariy"
        ]
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://api.ariyvpn.com/v1/updater/latest.json",
        "https://github.com/MeinCain/ariy-vpn-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NjVFOUMxREE0QzlGRDAKUldUUW4wemF3ZWxsdWJXaUtILzBBT2ZlcFpMQ3ZXNFc5eHpPYzR3SWpITTVvWHl4ckgxRFdVeVcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "publisher": "Ariy VPN",
    "shortDescription": "Ariy VPN для Windows",
    "longDescription": "Десктопный VPN-клиент Ariy для Windows на базе sing-box и Mihomo. Поддержка VLESS+Reality, VMess, Trojan, Shadowsocks, Hysteria2, TUIC, WireGuard, AnyTLS. Подключение в один клик через системный прокси или TUN. Be fast. Be stealthy. Be free.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mihomo",
      "binaries/sing-box"
    ],
    "resources": {
      "binaries/wintun.dll": "wintun.dll",
      "binaries/ariy-helper-x86_64-pc-windows-msvc.exe": "ariy-helper-x86_64-pc-windows-msvc.exe",
      "binaries/geoip.dat": "resources/geoip.dat",
      "binaries/geosite.dat": "resources/geosite.dat"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
